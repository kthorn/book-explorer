{
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "markdown-it": "^15.0.1",
    "pi-web-access": "0.24.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.7.22",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "node scripts/build-fonts.mjs && tailwindcss -i ./styles.css -o ./public/styles.css --minify && esbuild public/app.js --bundle --format=esm --minify --outfile=public/app.bundle.js && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && node dist/src/main.js"
  }
}
